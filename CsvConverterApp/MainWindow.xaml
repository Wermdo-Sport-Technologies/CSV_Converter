<Window x:Class="CsvConverterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Converter" Height="600" Width="900">

    <StackPanel Margin="20">

        <Button Content="Choose CSV-file"
                Click="ChooseInputFile_Click"
                Margin="0,0,0,10" />

        <TextBlock Text="Choose columns:"
                   FontWeight="Bold"
                   Margin="0,0,0,5" />

        <ListBox x:Name="ColumnsList"
                 SelectionMode="Multiple"
                 Height="200"
                 Margin="0,0,0,10" />

        <CheckBox x:Name="RemoveDuplicatesCheckBox"
                  Content="Remove duplicates"
                  Margin="0,0,0,10" />

        <TextBlock Text="Split by column:" />
        <ComboBox x:Name="SplitColumnComboBox"
                  Margin="0,0,0,10" />

        <TextBlock Text="Exportformat:" />
        <ComboBox x:Name="FormatComboBox"
                  Margin="0,0,0,10">
            <ComboBoxItem Content="xlsx" />
            <ComboBoxItem Content="md" />
            <ComboBoxItem Content="txt" />
        </ComboBox>

        <Button Content="Choose output folder"
                Click="ChooseOutputFolder_Click"
                Margin="0,0,0,10" />

        <Button Content="Convert"
                Click="Convert_Click"
                Margin="0,0,0,10" />

        <TextBlock x:Name="StatusText" />

    </StackPanel>
</Window>