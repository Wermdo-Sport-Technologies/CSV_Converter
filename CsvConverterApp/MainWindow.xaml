<Window x:Class="CsvConverterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Converter" Height="600" Width="900">

    <!--
        This WPF window defines the full desktop UI for the converter.
        The code-behind in MainWindow.xaml.cs handles button clicks, reads the
        selected settings, and sends them to the CSV and export services.
    -->
    <StackPanel Margin="20">

        <!-- Opens a standard Windows file picker and loads CSV headers into the controls below. -->
        <Button Content="Choose CSV-file"
                Click="ChooseInputFile_Click"
                Margin="0,0,0,10" />

        <TextBlock Text="Choose columns:"
                   FontWeight="Bold"
                   Margin="0,0,0,5" />

        <ListBox x:Name="ColumnsList"
                 SelectionMode="Multiple"
                 Height="200"
                 Margin="0,0,0,10" />

        <!-- When checked, duplicate source rows are removed before export. -->
        <CheckBox x:Name="RemoveDuplicatesCheckBox"
                  Content="Remove duplicates"
                  Margin="0,0,0,10" />

        <!-- The selected column is used to split the output into one file per unique value. -->
        <TextBlock Text="Split by column:" />
        <ComboBox x:Name="SplitColumnComboBox"
                  Margin="0,0,0,10" />

        <!-- ExportService supports txt, xlsx, md, and docx output formats. -->
        <TextBlock Text="Exportformat:" />
        <ComboBox x:Name="FormatComboBox"
                  Margin="0,0,0,10">
            <ComboBoxItem Content="txt" />
            <ComboBoxItem Content="xlsx" />
            <ComboBoxItem Content="md" />
            <ComboBoxItem Content="docx" />
        </ComboBox>

        <!-- When checked, Excel exports will create different sheets in the same file instead of separate files. -->
        <!--TODO: make this only visible when xlsx format is selected, or only enable it when xlsx format is selected -->
        <CheckBox x:Name="ExcelSheetsCheckBox"
          Content="For Excel: Create different sheets in the same file instead of separate files"
          Margin="0,0,0,10" />

        <!-- Uses Windows Forms FolderBrowserDialog because WPF has no built-in folder picker. -->
        <Button Content="Choose output folder"
                Click="ChooseOutputFolder_Click"
                Margin="0,0,0,10" />

        <Button Content="Convert"
                Click="Convert_Click"
                Margin="0,0,0,10" />

        <TextBlock x:Name="StatusText" />

    </StackPanel>
</Window>
